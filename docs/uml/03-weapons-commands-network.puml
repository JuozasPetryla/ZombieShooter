@startuml
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
package "Core" {
  interface "IWeapon" as Core_IWeapon {
    +WeaponKind Kind
    +int Damage
    +float FireCooldown
    +int Pellets
    +int MagazineSize
    +float ReloadTime
  }
  class "Pistol" as Core_Pistol {
    +WeaponKind Kind
    +int Damage
    +float FireCooldown
    +int Pellets
    +int MagazineSize
    +float ReloadTime
  }
  class "Shotgun" as Core_Shotgun {
    +WeaponKind Kind
    +int Damage
    +float FireCooldown
    +int Pellets
    +int MagazineSize
    +float ReloadTime
  }
  abstract class "WeaponDecorator" as Core_WeaponDecorator {
    #IWeapon Inner
    +WeaponKind Kind
    +int Damage
    +float FireCooldown
    +int Pellets
    +int MagazineSize
    +float ReloadTime
  }
  class "DamageBonus" as Core_DamageBonus {
    -int bonus
    +int Damage
  }
  class "FireRateBonus" as Core_FireRateBonus {
    -float multiplier
    +float FireCooldown
  }
  class "MagazineSizeBonus" as Core_MagazineSizeBonus {
    -int bonus
    +int MagazineSize
  }
  class "Player" as Core_Player {
    +int Health
    +Vector2 Aim
    +WeaponKind Weapon
    +float WeaponTime
    +IWeapon PistolGear
    +IWeapon ShotgunGear
    +IWeapon Gear
    +int PistolAmmo
    +int ShotgunAmmo
    +int Ammo
    +int MagazineSize
    +bool IsAlive
    +bool IsReloading
    +float ReloadRemaining
    ~long ActionVersion
  }
  class "GameSession" as Core_GameSession {
    +int Wave
    +int Score
    +SessionState State
    +Action<GameEvent> EventOccurred
    -Queue<IGameCommand> commands
    -Dictionary lastCommands
    +Update(dt, inputs) void
    +EnqueueCommand(command) bool
    +TryReload(playerId) bool
    +TrySelectWeapon(playerId, weapon) bool
    +UndoLast(playerId) bool
    +CaptureSnapshot(events, connectedPlayers) SessionSnapshot
    +ApplySnapshot(snapshot) void
  }
  class "GameFacade" as Core_GameFacade {
    +GameSession Session
    +SetInput(playerId, input) void
    +Queue(command) bool
    +Tick(dt) void
    +ClearInputs() void
    +Snapshot(connectedPlayers) SessionSnapshot
  }
  class "InputBuffer" as Core_InputBuffer {
    -Dictionary inputs
    +IReadOnlyDictionary Values
    +Set(playerId, input) void
    +Clear() void
  }
  class "CommandDispatcher" as Core_CommandDispatcher {
    -GameSession session
    +Queue(command) bool
  }
  class "MatchSimulation" as Core_MatchSimulation {
    -GameSession session
    +Tick(dt, inputs) void
  }
}
package "Commands" {
  interface "IGameCommand" as Commands_IGameCommand {
    +int PlayerId
    +Execute(session) bool
    +Undo(session) bool
  }
  abstract class "PlayerCommand" as Commands_PlayerCommand {
    -GameSession receiver
    -WeaponKind weapon
    -float reload
    -long version
    +int PlayerId
    +Execute(session) bool
    +Undo(session) bool
    {abstract} #Apply(session) bool
  }
  class "ReloadCommand" as Commands_ReloadCommand {
    #Apply(session) bool
  }
  class "SelectWeaponCommand" as Commands_SelectWeaponCommand {
    +WeaponKind Weapon
    #Apply(session) bool
  }
  class "UndoCommand" as Commands_UndoCommand {
    +int PlayerId
    +Execute(session) bool
    +Undo(session) bool
  }
}
package "Networking" {
  class "GameServer" as Networking_GameServer {
    -TcpListener listener
    -GameFacade game
    -TcpClient[] clients
    +int Port
    +Start() void
    -AcceptAsync() Task
    -ServeAsync(client, slot) Task
    -TickAsync() Task
    +DisposeAsync() ValueTask
  }
  class "NetworkGameClient" as Networking_NetworkGameClient {
    -TcpClient client
    -Queue<NetworkAction> actions
    +int PlayerId
    +ServerFrame Latest
    +string Error
    {static} +ConnectAsync(host, port) Task<NetworkGameClient>
    +SetInput(input) void
    +Queue(action) bool
    +Dispose() void
  }
  class "WireProtocol" as Networking_WireProtocol {
    <<static>>
    {static} +int MaximumBytes
    {static} +WriteAsync<T>(stream, message, cancellation) Task
    {static} +ReadAsync<T>(stream, cancellation) Task<T>
  }
}
package "Presentation" {
  class "ZombieShooterGame" as Presentation_ZombieShooterGame {
    -GameFacade facade
    -NetworkGameClient network
    -GameSession session
    #Update(gameTime) void
    #Draw(gameTime) void
    -Queue(command) void
    -OnGameEvent(message) void
  }
}
Core_Entity <|-- Core_Player
Core_GameSession --> "1" Core_IGameMode : mode
Core_GameSession --> "1" Core_IDropPolicy : drops
Core_GameSession *-- Core_EntityFactory
Core_GameSession "1" *-- "0..*" Core_Zombie
Core_GameSession "1" *-- "0..*" Core_Bullet
Core_GameSession "1" *-- "0..*" Core_Pickup
Core_IWeapon <|.. Core_Pistol
Core_IWeapon <|.. Core_Shotgun
Core_IWeapon <|.. Core_WeaponDecorator
Core_WeaponDecorator --> "1" Core_IWeapon : Inner
Core_WeaponDecorator <|-- Core_DamageBonus
Core_WeaponDecorator <|-- Core_FireRateBonus
Core_WeaponDecorator <|-- Core_MagazineSizeBonus
Core_Player --> "1" Core_IWeapon : PistolGear
Core_Player --> "1" Core_IWeapon : ShotgunGear
Commands_IGameCommand <|.. Commands_PlayerCommand
Commands_IGameCommand <|.. Commands_UndoCommand
Commands_PlayerCommand <|-- Commands_ReloadCommand
Commands_PlayerCommand <|-- Commands_SelectWeaponCommand
Commands_PlayerCommand --> Core_GameSession : receiver
Commands_UndoCommand ..> Core_GameSession : parameter
Core_GameSession --> "0..64" Commands_IGameCommand : pending commands
Core_GameSession --> "0..2" Commands_IGameCommand : last successful per player
Core_GameSession "1" *-- "1..2" Core_Player
Core_GameFacade *-- Core_InputBuffer
Core_GameFacade *-- Core_CommandDispatcher
Core_GameFacade *-- Core_MatchSimulation
Core_GameFacade *-- Core_GameSession
Core_CommandDispatcher --> Core_GameSession
Core_MatchSimulation --> Core_GameSession
Presentation_ZombieShooterGame --> Core_GameFacade : client 1
Networking_GameServer --> Core_GameFacade : client 2
Presentation_ZombieShooterGame --> Networking_NetworkGameClient
Networking_NetworkGameClient ..> Networking_WireProtocol
Networking_GameServer ..> Networking_WireProtocol
package "Core" {
  class "Bullet" as Core_Bullet <<reference>>
}
package "Core" {
  class "Entity" as Core_Entity <<reference>>
}
package "Core" {
  class "EntityFactory" as Core_EntityFactory <<reference>>
}
package "Core" {
  class "IDropPolicy" as Core_IDropPolicy <<reference>>
}
package "Core" {
  class "IGameMode" as Core_IGameMode <<reference>>
}
package "Core" {
  class "Pickup" as Core_Pickup <<reference>>
}
package "Core" {
  class "Zombie" as Core_Zombie <<reference>>
}
@enduml
